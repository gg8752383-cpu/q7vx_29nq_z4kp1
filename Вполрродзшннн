-- SMART DODGE ASSIST
-- LocalScript for your own Roblox Studio experience.
-- Modes:
--   MANUAL  : no intervention at safe distances
--   ASSIST  : strong, adaptive directional assistance
--   CLOSE   : automatic evasive movement at close range

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Player = Players.LocalPlayer
if not Player then
    return
end

local BIND_NAME = "SmartDodgeAssistV2"
local GUI_NAME = "SmartDodgeAssistUI"

pcall(function()
    RunService:UnbindFromRenderStep(BIND_NAME)
end)

pcall(function()
    local old = Player.PlayerGui:FindFirstChild(GUI_NAME)
    if old then
        old:Destroy()
    end
end)

--==================================================
-- CONFIGURATION
--==================================================

local CFG = {
    Enabled = true,

    -- Detection
    MaxDistance = 48,
    AssistDistance = 24,

    -- Full dodge with hysteresis
    FullEnterDistance = 8,
    FullExitDistance = 12,

    -- Medium-range assistance
    MinAssistWeight = 0.28,
    MaxAssistWeight = 0.78,

    -- Prediction
    PredictionTime = 0.42,
    ApproachDangerScale = 12,
    FacingBonus = 0.16,

    -- Evasive movement
    SideWeight = 1.0,
    EscapeBaseWeight = 0.25,
    EscapeMaxWeight = 0.90,

    -- Adaptive zigzag
    ZigzagCooldown = 0.78,
    EmergencySideChangeDistance = 6,

    -- Obstacle checks
    SideCheckDistance = 8,
    SideBlockedThreshold = 0.24,

    -- Scanning
    ScanInterval = 0.10,
}

--==================================================
-- STATE
--==================================================

local Enabled = CFG.Enabled
local FullMode = false

local Target = nil
local TargetRoot = nil
local TargetDistance = math.huge
local Danger = 0

local SideSign = 1
local ZigClock = 0
local ScanClock = 0

local Controls = nil
local Character = nil
local Humanoid = nil
local Root = nil

--==================================================
-- INPUT MODULE
--==================================================

task.spawn(function()
    local ok, result = pcall(function()
        local scripts = Player:WaitForChild("PlayerScripts", 10)
        if not scripts then
            return nil
        end

        local module = scripts:WaitForChild("PlayerModule", 10)
        if not module then
            return nil
        end

        local playerModule = require(module)
        return playerModule:GetControls()
    end)

    if ok then
        Controls = result
    else
        warn("[SmartDodge] Default controls unavailable")
    end
end)

--==================================================
-- CHARACTER
--==================================================

local function RefreshCharacter()
    Character = Player.Character

    if not Character then
        Humanoid = nil
        Root = nil
        return false
    end

    Humanoid = Character:FindFirstChildOfClass("Humanoid")
    Root = Character:FindFirstChild("HumanoidRootPart")

    return Humanoid ~= nil
        and Root ~= nil
        and Humanoid.Health > 0
end

Player.CharacterAdded:Connect(function()
    FullMode = false
    Target = nil
    TargetRoot = nil
    TargetDistance = math.huge

    task.wait(0.25)
    RefreshCharacter()
end)

--==================================================
-- TEAM FILTER
--==================================================

local function IsSpectator(player)
    local team = player.Team
    if not team then
        return false
    end

    local name = string.lower(team.Name)

    return string.find(name, "spectat", 1, true) ~= nil
        or string.find(name, "lobby", 1, true) ~= nil
        or string.find(name, "waiting", 1, true) ~= nil
end

local function IsOpponent(player)
    if player == Player then
        return false
    end

    if IsSpectator(player) or IsSpectator(Player) then
        return false
    end

    if Player.Team and player.Team then
        return Player.Team ~= player.Team
    end

    return true
end

local function GetAliveRoot(player)
    if not player or not player.Character then
        return nil
    end

    local model = player.Character
    local hum = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")

    if not hum or not root or hum.Health <= 0 then
        return nil
    end

    return root
end

--==================================================
-- TARGET SELECTION
--==================================================

local function ScanTarget()
    if not Root then
        Target = nil
        TargetRoot = nil
        return
    end

    local bestPlayer = nil
    local bestRoot = nil
    local bestScore = CFG.MaxDistance

    for _, opponent in ipairs(Players:GetPlayers()) do
        if IsOpponent(opponent) then
            local enemyRoot = GetAliveRoot(opponent)

            if enemyRoot then
                local distance = (
                    enemyRoot.Position - Root.Position
                ).Magnitude

                if distance <= CFG.MaxDistance then
                    -- Slightly prefer the previous target to
                    -- prevent rapid target switching.
                    local score = distance

                    if opponent == Target then
                        score = score - 3
                    end

                    if score < bestScore then
                        bestScore = score
                        bestPlayer = opponent
                        bestRoot = enemyRoot
                    end
                end
            end
        end
    end

    Target = bestPlayer
    TargetRoot = bestRoot
end

--==================================================
-- RAYCAST HELPERS
--==================================================

local function MakeRayParams(extraCharacter)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local exclusions = {}

    if Character then
        table.insert(exclusions, Character)
    end

    if extraCharacter then
        table.insert(exclusions, extraCharacter)
    end

    params.FilterDescendantsInstances = exclusions
    params.IgnoreWater = true

    return params
end

local function GetClearance(direction)
    if not Root or direction.Magnitude < 0.001 then
        return 0
    end

    local origin = Root.Position + Vector3.new(0, 1, 0)
    local rayDirection = direction.Unit * CFG.SideCheckDistance

    local result = Workspace:Raycast(
        origin,
        rayDirection,
        MakeRayParams()
    )

    if not result then
        return 1
    end

    return math.clamp(
        result.Distance / CFG.SideCheckDistance,
        0,
        1
    )
end

local function HasLineOfSight(enemyRoot)
    if not Root or not enemyRoot then
        return false
    end

    local difference = Root.Position - enemyRoot.Position

    if difference.Magnitude < 0.01 then
        return true
    end

    local result = Workspace:Raycast(
        enemyRoot.Position,
        difference,
        MakeRayParams(enemyRoot.Parent)
    )

    return result == nil
end

--==================================================
-- WORLD / CAMERA MOVEMENT
--==================================================

local function ClampDirection(vector)
    vector = Vector3.new(vector.X, 0, vector.Z)

    if vector.Magnitude > 1 then
        return vector.Unit
    end

    return vector
end

local function WorldToCamera(worldDirection)
    local camera = Workspace.CurrentCamera

    if not camera then
        return Vector3.zero
    end

    local forward = camera.CFrame.LookVector
    local right = camera.CFrame.RightVector

    forward = Vector3.new(forward.X, 0, forward.Z)
    right = Vector3.new(right.X, 0, right.Z)

    if forward.Magnitude < 0.001
        or right.Magnitude < 0.001 then
        return Vector3.zero
    end

    forward = forward.Unit
    right = right.Unit

    return ClampDirection(Vector3.new(
        worldDirection:Dot(right),
        0,
        -worldDirection:Dot(forward)
    ))
end

local function ReadManualInput()
    if not Controls then
        return Vector3.zero
    end

    local ok, vector = pcall(function()
        return Controls:GetMoveVector()
    end)

    if not ok or typeof(vector) ~= "Vector3" then
        return Vector3.zero
    end

    return ClampDirection(vector)
end

--==================================================
-- THREAT PREDICTION
--==================================================

local function CalculateThreat(enemyRoot)
    if not Root or not enemyRoot then
        return 0, 0, Vector3.zero
    end

    local offset = Root.Position - enemyRoot.Position
    local distance = offset.Magnitude

    if distance < 0.001 then
        return 1, 0, Vector3.new(1, 0, 0)
    end

    local away = Vector3.new(offset.X, 0, offset.Z)

    if away.Magnitude < 0.001 then
        away = Vector3.new(1, 0, 0)
    else
        away = away.Unit
    end

    -- Positive closing speed means the opponent is
    -- getting closer to our character.
    local enemyVelocity = enemyRoot.AssemblyLinearVelocity
    local ownVelocity = Root.AssemblyLinearVelocity

    enemyVelocity = Vector3.new(
        enemyVelocity.X, 0, enemyVelocity.Z
    )

    ownVelocity = Vector3.new(
        ownVelocity.X, 0, ownVelocity.Z
    )

    local closingSpeed = math.max(
        0,
        (enemyVelocity - ownVelocity):Dot(away)
    )

    -- Estimate separation at a short time in the future.
    local predictedDistance = math.max(
        0,
        distance - closingSpeed * CFG.PredictionTime
    )

    local dangerRange = math.clamp(
        (CFG.AssistDistance - predictedDistance)
            / math.max(
                CFG.AssistDistance - CFG.FullEnterDistance,
                1
            ),
        0,
        1
    )

    -- Facing us can increase risk, but it does NOT prove
    -- that an attack animation has started.
    local look = enemyRoot.CFrame.LookVector
    look = Vector3.new(look.X, 0, look.Z)

    local facing = 0

    if look.Magnitude > 0.001 then
        facing = math.max(0, look.Unit:Dot(away))
    end

    local approachBonus = math.clamp(
        closingSpeed / CFG.ApproachDangerScale,
        0,
        1
    ) * 0.22

    local facingBonus = facing * CFG.FacingBonus

    local danger = math.clamp(
        dangerRange * 0.75
            + approachBonus
            + facingBonus,
        0,
        1
    )

    if not HasLineOfSight(enemyRoot) then
        danger = danger * 0.55
    end

    return danger, closingSpeed, away
end

--==================================================
-- ADAPTIVE DODGE DIRECTION
--==================================================

local function CalculateDodge(enemyRoot, danger, closingSpeed, away, dt)
    ZigClock += dt

    -- Tangent directions produce lateral dodges instead
    -- of simply running straight away from the opponent.
    local tangent = Vector3.new(-away.Z, 0, away.X)

    local currentSide = tangent * SideSign
    local otherSide = -currentSide

    local currentClearance = GetClearance(currentSide)
    local otherClearance = GetClearance(otherSide)

    -- Avoid repeatedly selecting a blocked side.
    if currentClearance < CFG.SideBlockedThreshold
        and otherClearance > currentClearance then

        SideSign = -SideSign
        currentSide = -currentSide
        currentClearance, otherClearance =
            otherClearance, currentClearance
    end

    -- Zigzag changes only while a threat is active.
    -- Emergency reversal is used when the preferred path
    -- is obstructed or the opponent gets extremely close.
    local emergency = TargetDistance
        <= CFG.EmergencySideChangeDistance

    if danger >= 0.55
        and (ZigClock >= CFG.ZigzagCooldown or emergency) then

        if otherClearance >= currentClearance
            or not emergency then
            SideSign = -SideSign
        end

        ZigClock = 0

        currentSide = tangent * SideSign
        otherSide = -currentSide

        currentClearance = GetClearance(currentSide)
        otherClearance = GetClearance(otherSide)

        if currentClearance < CFG.SideBlockedThreshold
            and otherClearance > currentClearance then

            SideSign = -SideSign
            currentSide = -currentSide
            currentClearance, otherClearance =
                otherClearance, currentClearance
        end
    end

    -- Stronger retreat when the enemy closes rapidly.
    local escapeWeight = CFG.EscapeBaseWeight
        + (CFG.EscapeMaxWeight - CFG.EscapeBaseWeight)
        * math.clamp(closingSpeed / 16, 0, 1)

    -- Bias towards lateral movement for unpredictable
    -- zigzags rather than repeated straight-line retreat.
    local sideWeight = CFG.SideWeight

    if currentClearance < CFG.SideBlockedThreshold then
        sideWeight = 0.25
        escapeWeight = CFG.EscapeMaxWeight
    end

    local direction = currentSide * sideWeight
        + away * escapeWeight

    if direction.Magnitude < 0.001 then
        return away
    end

    return direction.Unit
end


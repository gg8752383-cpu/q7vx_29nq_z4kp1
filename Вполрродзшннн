--==================================================
-- MAIN CONTROLLER
--==================================================

local function Update(dt)
    if not RefreshCharacter() then
        FullMode = false
        Target = nil
        TargetRoot = nil
        status.Text = "WAITING FOR CHARACTER"
        return
    end

    if not Enabled then
        FullMode = false
        status.Text = "MANUAL CONTROL"
        return
    end

    ScanClock += dt

    if ScanClock >= CFG.ScanInterval then
        ScanClock = 0
        ScanTarget()
    end

    if not Target or not TargetRoot
        or not TargetRoot.Parent then

        Target = nil
        TargetRoot = nil
        TargetDistance = math.huge
        FullMode = false
        status.Text = "NO OPPONENT"
        return
    end

    TargetDistance = (TargetRoot.Position - Root.Position).Magnitude

    if TargetDistance > CFG.MaxDistance then
        Target = nil
        TargetRoot = nil
        FullMode = false
        status.Text = "NO OPPONENT"
        return
    end

    local danger, closingSpeed, away =
        CalculateThreat(TargetRoot)

    Danger = danger

    -- Full-mode hysteresis prevents rapid toggling.
    if FullMode then
        if TargetDistance > CFG.FullExitDistance then
            FullMode = false
        end
    elseif TargetDistance <= CFG.FullEnterDistance then
        FullMode = true
    end

    local dodgeWorld = CalculateDodge(
        TargetRoot,
        danger,
        closingSpeed,
        away,
        dt
    )

    local dodgeInput = WorldToCamera(dodgeWorld)
    local manualInput = ReadManualInput()

    if FullMode then
        -- CLOSE RANGE: full dodge direction.
        Humanoid:Move(dodgeInput, true)

        status.Text = string.format(
            "FULL DODGE | %.0f studs",
            TargetDistance
        )

        return
    end

    -- Beyond assist range, do not alter movement.
    if TargetDistance > CFG.AssistDistance then
        status.Text = "MANUAL CONTROL"
        return
    end

    -- Prevent unwanted autonomous movement when the
    -- player is idle and the threat is not severe.
    if manualInput.Magnitude < 0.06 and danger < 0.62 then
        status.Text = string.format(
            "READY | %.0f studs",
            TargetDistance
        )
        return
    end

    -- Assistance strength increases with predicted danger.
    local assistWeight = CFG.MinAssistWeight
        + (CFG.MaxAssistWeight - CFG.MinAssistWeight)
        * danger

    -- Stronger assistance as the opponent enters close range.
    local rangeFactor = 1 - math.clamp(
        TargetDistance / CFG.AssistDistance,
        0,
        1
    )

    assistWeight = math.clamp(
        assistWeight + rangeFactor * 0.18,
        0,
        0.90
    )

    local combined = manualInput * (1 - assistWeight)
        + dodgeInput * assistWeight

    if combined.Magnitude > 0.05 then
        combined = combined.Unit
    else
        combined = dodgeInput
    end

    -- Camera-relative direction keeps the result compatible
    -- with keyboard, gamepad and standard touch movement.
    Humanoid:Move(combined, true)

    status.Text = string.format(
        "SMART ASSIST | %.0f studs | %d%%",
        TargetDistance,
        math.floor(assistWeight * 100 + 0.5)
    )
end

RunService:BindToRenderStep(
    BIND_NAME,
    Enum.RenderPriority.Character.Value + 1,
    function(dt)
        local ok, err = pcall(Update, dt)

        if not ok then
            FullMode = false
            warn("[SmartDodge] Controller error:", err)
        end
    end
)

print("[SmartDodge] Adaptive dodge assistant loaded.")

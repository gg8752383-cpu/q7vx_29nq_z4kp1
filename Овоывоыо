local dt=now-w.t
if dt>0.25 then
w.x,w.y,w.z,w.t,w.s=px,py,pz,now,m w.n=0 scheduleWatch(w) return end
if dt<=0.004 then return end
local vx,vy,vz=(px-w.x)/dt,(py-w.y)/dt,(pz-w.z)/dt
local dm=m-w.s local growth=dm/dt
w.x,w.y,w.z,w.t,w.s=px,py,pz,now,m
local rvx,rvy,rvz=vx-mvx,vy-mvy,vz-mvz
if rvx*rvx+rvy*rvy+rvz*rvz>=MIN_SP2 then
if acceptProj(part,m,myRoot) then
watch[part]=nil threats[part]=newRecord(part,"Proj",now,px,py,pz,vx,vy,vz,m,0) return end
elseif growth>=Config.AOEGrowthRate and dm>=Config.AOEMinGrowthStep then
if acceptZone(part,myRoot) then
watch[part]=nil threats[part]=newRecord(part,zoneKind(s,m),now,px,py,pz,0,0,0,m,growth) return end end
scheduleWatch(w)
else
if w then watch[part]=nil end
local v=part.AssemblyLinearVelocity local vx,vy,vz=v.X,v.Y,v.Z
local rvx,rvy,rvz=vx-mvx,vy-mvy,vz-mvz
if rvx*rvx+rvy*rvy+rvz*rvz>=MIN_SP2 then
local s=part.Size local m=math.max(s.X,s.Y,s.Z)

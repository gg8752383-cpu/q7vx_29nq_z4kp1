local controlsObj=nil
local function readManual()
if controlsObj==nil then
local ok,res=pcall(function()
return require(LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule",2)):GetControls() end)
controlsObj=(ok and res) or false end
if controlsObj then
local mv=controlsObj:GetMoveVector()
return mv.X*mv.X+mv.Z*mv.Z>0.09 end
return false end
local function applyMove(dt)
if not Ctl.active then return end
local hum=ctx.hum
if not hum or hum.Parent==nil then return end
if Config.ManualOverride and not Config.NpcModel and readManual() then return end
local ws=Ctl.wantSpeed
local s=Ctl.speed local h=Ctl.heading local tgt=0
if ws>0.02 then
local dhFull=(math.atan2(Ctl.wantZ,Ctl.wantX)-h+math.pi)%TAU-math.pi
local dh=dhFull
if s<0.12 then h=h+dh
else
local maxStep=Ctl.wantTurn*DEG*dt
if dh>maxStep then dh=maxStep elseif dh<-maxStep then dh=-maxStep end
h=h+dh end
tgt=ws*(1-0.35*math.min(1,math.abs(dhFull)/math.pi)) end
if tgt>s then s=math.min(tgt,s+Config.SpeedAccel*dt)
else s=math.max(tgt,s-Config.SpeedDecel*dt) end
h=(h+math.pi)%TAU-math.pi
Ctl.heading,Ctl.speed=h,s
hum:Move(AXIS_X*(math.cos(h)*s)+AXIS_Z*(math.sin(h)*s),false) end
local function updateState(now)
local new
if not Enabled then new="Disabled"
elseif cachedReason then new="Blocked"
elseif ctx.dashing then new="Evading"
elseif Ctl.active then new="Combat"
elseif now<ctx.cooldownEnd then new="Cooldown"
else new="Idle" end
if new~=fsm then
fsm=new LocalPlayer:SetAttribute("AutoEvasionState",fsm) end
if Config.ReasonAttribute then
local r=cachedReason or ""
if LocalPlayer:GetAttribute("AutoEvasionReason")~=r then
LocalPlayer:SetAttribute("AutoEvasionReason",r) end end end
local guardAcc,pingAcc,brainAcc=0,0,0
local function onHeartbeat(dt)
local c=ctx
if not c.hrp then return end
local now=os.clock()
frame+=1
if Config.DashWatchdog and c.char and c.hrp and c.hrp.Parent and Enabled then
if not c.att or c.att.Parent==nil then
local att=Instance.new("Attachment")
att.Name="AutoEvadeAttachment" att.Parent=c.hrp
c.att=att c.lv,c.ao=nil,nil end
if not c.lv or c.lv.Parent==nil then
local lv=Instance.new("LinearVelocity")
lv.Name="AutoEvadeDash" lv.Attachment0=c.att
lv.RelativeTo=Enum.ActuatorRelativeTo.World
lv.VelocityConstraintMode=Enum.VelocityConstraintMode.Vector
lv.ForceLimitMode=Enum.ForceLimitMode.PerAxis
lv.MaxAxesForce=Vector3.new(Config.DashForce,0,Config.DashForce)
lv.VectorVelocity=Vector3.zero lv.Enabled=false
lv.Parent=c.hrp c.lv=lv end
if not c.ao or c.ao.Parent==nil then
local ao=Instance.new("AlignOrientation")
ao.Name="AutoMansFacing"
ao.Mode=Enum.OrientationAlignmentMode.OneAttachment
ao.Attachment0=c.att ao.RigidityEnabled=false
ao.MaxTorque=1e5 ao.Responsiveness=25 ao.Enabled=false
ao.Parent=c.hrp c.ao=ao
if Ctl.facing then ao.Enabled=true end end end
if c.dashing then
local lv=c.lv local el=now-c.dashStart
if el>=c.dashDur or not lv or not lv.Parent or c.hum.Health<=0 or cachedReason or not Enabled then
endDash()
else
local tau=el/c.dashDur
lv.VectorVelocity=c.dashDir*(c.dashPeak*(1-tau*tau)) end end
pingAcc+=dt
if pingAcc>=0.25 then pingAcc=0 updatePing() end
guardAcc+=dt
if guardAcc>=0.1 then guardAcc=0 cachedReason=guardReason() end
if not Enabled or cachedReason then
if Ctl.active then setControl(false) end
updateState(now) return end
local every=Config.CalmScanEvery
if now<dangerUntil then every=Config.DangerScanEvery end
if frame%every==0 then step(now) end
brainAcc+=dt
if brainAcc>=1/Config.BrainHz then
local bdt=brainAcc brainAcc=0 brain(now,bdt) end
updateState(now) end

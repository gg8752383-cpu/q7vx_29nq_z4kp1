else stagger=(stagger+1)%3 w.next=scanIdx+3+stagger end end
local function observePart(part,w,now,mvx,mvy,mvz,myRoot)
if part.Anchored then
local p=part.Position local px,py,pz=p.X,p.Y,p.Z
local s=part.Size local m=math.max(s.X,s.Y,s.Z)
if not w then
w={x=px,y=py,z=pz,t=now,s=m,n=0,next=0}
watch[part]=w scheduleWatch(w)
local born=bornAt[part]
if born and now-born<=Config.FreshWindow then tryFresh(part,s,m,now,px,py,pz,myRoot) end

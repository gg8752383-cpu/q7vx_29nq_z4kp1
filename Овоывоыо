local function dashDisp(t,D,delay,dur)
local u=(t-delay)/dur
if u<=0 then return 0 end
if u>=1 then return D end
return D*1.5*(u-u*u*u/3) end
local function projClearance(rec,cx,cz,D,dur,delay,mx,my,mz,grav)
local rx,ry,rz=rec.px-mx,rec.py-my,rec.pz-mz
local vx,vy,vz=rec.vx,rec.vy,rec.vz
local g=rec.gravity and -grav or 0
local tEnd=math.min(rec.baseTti+0.3,Config.Horizon+0.3)
local step=Config.SampleStep local hh=Config.BodyHalfHeight
local s0=dashDisp(0,D,delay,dur)
local x0=rx-cx*s0 local z0=rz-cz*s0 local y0=ry
local minD2=math.huge local t0=0
while t0<tEnd do
local t1=t0+step local s1=dashDisp(t1,D,delay,dur)
local x1=rx+vx*t1-cx*s1 local z1=rz+vz*t1-cz*s1
local y1=ry+vy*t1+0.5*g*t1*t1
local ex,ey,ez=x1-x0,y1-y0,z1-z0
local l2=ex*ex+ey*ey+ez*ez local u=0
if l2>1e-9 then
u=-(x0*ex+y0*ey+z0*ez)/l2
if u<0 then u=0 elseif u>1 then u=1 end end
local qx,qy,qz=x0+ex*u,y0+ey*u,z0+ez*u
local ay=math.abs(qy)-hh if ay<0 then ay=0 end
local d2=qx*qx+qz*qz+ay*ay
if d2<minD2 then minD2=d2 end
x0,y0,z0=x1,y1,z1 t0=t1 end

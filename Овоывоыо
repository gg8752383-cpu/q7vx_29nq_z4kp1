if anch then
if dt>0.004 then
vx=rec.vx*0.4+((px-rec.px)/dt)*0.6
vy=rec.vy*0.4+((py-rec.py)/dt)*0.6
vz=rec.vz*0.4+((pz-rec.pz)/dt)*0.6
else vx,vy,vz=rec.vx,rec.vy,rec.vz end
rec.gravity=false
else
local v=part.AssemblyLinearVelocity vx,vy,vz=v.X,v.Y,v.Z
if dt>0.01 then
rec.accY=rec.accY*0.7+((vy-rec.vy)/dt)*0.3
rec.samples+=1
if rec.samples>=4 then rec.gravity=rec.accY<-0.5*Workspace.Gravity end end end
rec.vx,rec.vy,rec.vz=vx,vy,vz rec.t=now
else
local s=part.Size local m=math.max(s.X,s.Y,s.Z)
if dt>0.004 then
local gr=(m-rec.s)/dt
rec.growth=rec.growth*0.6+gr*0.4
if gr>=Config.AOEGrowthRate then
local untilT=now+(rec.kind=="AOE" and Config.ZoneLinger or Config.BeamLinger)
if untilT>rec.activeUntil then rec.activeUntil=untilT end end
rec.s=m rec.t=now end end
rec.px,rec.py,rec.pz=px,py,pz rec.lastSeen=now end

local function pushActive(rec) rec.urgent=true activeN+=1 active[activeN]=rec end
local function evalProj(rec,mx,my,mz,mvx,mvy,mvz,pingSec,grav,now)
local rvx,rvy,rvz=rec.vx-mvx,rec.vy-mvy,rec.vz-mvz
local sp2=rvx*rvx+rvy*rvy+rvz*rvz
if sp2<MIN_SP2 then
if rec.slowSince==0 then rec.slowSince=now end
return end
rec.slowSince=0
local rx,ry,rz=rec.px-mx,rec.py-my,rec.pz-mz
if -(rx*rvx+ry*rvy+rz*rvz)<=0 then return end
local R=rec.hitR local R2=R*R local hh=Config.BodyHalfHeight
local g=rec.gravity and -grav or 0
local step=Config.SampleStep local horizon=Config.Horizon
local hitT=nil local x0,y0,z0=rx,ry,rz local t0=0
while t0<horizon do
local t1=t0+step
local x1=rx+rvx*t1 local z1=rz+rvz*t1
local y1=ry+rvy*t1+0.5*g*t1*t1
local ex,ey,ez=x1-x0,y1-y0,z1-z0
local l2=ex*ex+ey*ey+ez*ez local u=0
if l2>1e-9 then
u=-(x0*ex+y0*ey+z0*ez)/l2
if u<0 then u=0 elseif u>1 then u=1 end end
local qx,qy,qz=x0+ex*u,y0+ey*u,z0+ez*u
local ay=math.abs(qy)-hh if ay<0 then ay=0 end
local d2=qx*qx+qz*qz+ay*ay
if d2<=R2 then
local back=0
if l2>1e-9 then back=math.sqrt(R2-d2)/(math.sqrt(l2)/step) end
hitT=t0+u*step-back
if hitT<0 then hitT=0 end
break end
x0,y0,z0=x1,y1,z1 t0=t1 end
if hitT==nil then return end
dangerUntil=now+0.4
local adj=hitT+Config.PingSign*pingSec
if adj<0 or hitT<=0.001 then adj=0 end
rec.baseTti=hitT rec.tti=adj
local hs2=rvx*rvx+rvz*rvz
if hs2>=4 then
local hs=math.sqrt(hs2) rec.dirx,rec.dirz,rec.hasDir=rvx/hs,rvz/hs,true
else rec.hasDir=false end
if adj<=Config.TriggerLead then pushActive(rec) end end
local function evalAOE(rec,mx,my,mz,now)
local part=rec.part local s=part.Size
local sx,sy,sz=s.X,s.Y,s.Z
local m=math.max(sx,sy,sz) local mn=math.min(sx,sy,sz)
local radius=math.min(m*0.5,Config.MaxZoneRadius)
local grow=rec.growth if grow<0 then grow=0 end
local radP=radius+grow*0.5*Config.ZoneLookahead
rec.radius=radius rec.safeR=radP+Config.BodyRadius+Config.HitMargin
if mn<0.35*m then rec.halfY=mn*0.5+1 else rec.halfY=radius end
local dx,dz=mx-rec.px,mz-rec.pz
local ay=math.abs(my-rec.py)-Config.BodyHalfHeight-rec.halfY
if ay<0 then ay=0 end
if math.sqrt(dx*dx+dz*dz+ay*ay)>rec.safeR then return end
rec.tti,rec.baseTti=0,0 dangerUntil=now+0.4 pushActive(rec) end
local function beamGeometry(rec)
local part=rec.part local s=part.Size local cf=part.CFrame
local axis,len,w
if s.Z>=s.X and s.Z>=s.Y then axis,len,w=cf.LookVector,s.Z,math.max(s.X,s.Y)
elseif s.X>=s.Y then axis,len,w=cf.RightVector,s.X,math.max(s.Y,s.Z)
else axis,len,w=cf.UpVector,s.Y,math.max(s.X,s.Z) end
local ext=rec.growth if ext<0 then ext=0 end
local L=len+ext*Config.BeamLookahead local c=cf.Position local h=L*0.5
rec.ox,rec.oy,rec.oz=c.X-axis.X*h,c.Y-axis.Y*h,c.Z-axis.Z*h
rec.ax,rec.ay,rec.az=axis.X,axis.Y,axis.Z rec.blen=L
rec.lim=w*0.5+Config.BodyHalfHeight*0.9+Config.HitMargin*0.5 end
local function evalBeam(rec,mx,my,mz,now)
beamGeometry(rec)
local d2=segDist2(rec.ox,rec.oy,rec.oz,rec.ax,rec.ay,rec.az,rec.blen,mx,my,mz)
if d2<=rec.lim*rec.lim then
rec.tti,rec.baseTti=0,0 dangerUntil=now+0.4 pushActive(rec) end end
local function evaluate(now)
activeN=0
local c=ctx local p=c.hrp.Position local v=c.hrp.AssemblyLinearVelocity
local mx,my,mz=p.X,p.Y,p.Z local mvx,mvy,mvz=v.X,v.Y,v.Z
local pingSec=pingMs/1000 local grav=Workspace.Gravity
for _,rec in pairs(threats) do
rec.urgent=false
if now>=rec.handledUntil then
local kind=rec.kind
if kind=="Proj" then evalProj(rec,mx,my,mz,mvx,mvy,mvz,pingSec,grav,now)
elseif kind=="AOE" then evalAOE(rec,mx,my,mz,now)
else evalBeam(rec,mx,my,mz,now) end end end end

local function zoneKind(s,m)
local a,b,c3=s.X,s.Y,s.Z
local mn=math.min(a,b,c3)
local mid=a+b+c3-m-mn
if m/math.max(mid,0.05)>=Config.BeamAspect and mid<=Config.BeamMaxThickness then return "Beam" end
return "AOE" end

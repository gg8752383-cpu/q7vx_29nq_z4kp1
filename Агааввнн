}

local function dbg(...) if Config.Debug then print("[AssistMans]",...) end end

local function hasMover(p)
    for i=1,#MOVER_CLASSES do
        if p:FindFirstChildWhichIsA(MOVER_CLASSES[i]) then return true end
    end
    return false
end

local function getTarget() return Config.NpcModel or LocalPlayer.Character end

local function smoothstep(t)
    if t<=0 then return 0 end
    if t>=1 then return 1 end
    return t*t*(3-2*t)
end

local function dashPos(el,dur,D) return D*smoothstep(el/dur) end

-- ===================== АВТО-ДЕТЕКТ =====================
local function detectSpeed()
    local hum=ctx.hum
    if not hum then return end
    local ok,ws=pcall(function() return hum.WalkSpeed end)
    if ok and type(ws)=="number" and ws>0 and ws<200 then
        Dyn.baseWalkSpeed=ws
        Dyn.dashSpeed=ws*Config.SpeedMultiplier
        dbg("speed detected:",ws,"dash:",Dyn.dashSpeed)
    end
end

local function detectRig()
    local char=ctx.char
    if not char then return end
    if char:FindFirstChild("LowerTorso") or char:FindFirstChild("UpperTorso") then
        Dyn.rigType="R15"
    elseif char:FindFirstChild("Torso") then
        Dyn.rigType="R6"
    else
        Dyn.rigType="Custom"
    end
    dbg("rig:",Dyn.rigType)
end

local function detectNetworkOwner()
    local hrp=ctx.hrp
    if not hrp then
        Dyn.isNetworkOwner=true
        return
    end
    local ok,owner=pcall(function() return hrp:GetNetworkOwner() end)
    if ok then
        Dyn.isNetworkOwner=(owner==LocalPlayer or owner==nil)
    else
        Dyn.isNetworkOwner=true
    end
    dbg("network owner:",Dyn.isNetworkOwner and "client" or "server")
end

local function detectMoveMethod()
    local hum=ctx.hum
    local hrp=ctx.hrp
    if not hum or not hrp then
        Dyn.moveMethod="none"
        Dyn.canMove=false
        return
    end
    -- Пробуем hum:Move()
    local ok=pcall(function()
        if typeof(hum.Move)=="function" then
            hum:Move(Vector3.zero,false)
        else
            error("no move")
        end
    end)
    if ok then
        Dyn.moveMethod="hum"
        Dyn.canMove=true
        return
    end
    -- Fallback: AssemblyLinearVelocity
    local ok2=pcall(function()
        local v=hrp.AssemblyLinearVelocity
        hrp.AssemblyLinearVelocity=v
    end)
    if ok2 then
        Dyn.moveMethod="assembly"
        Dyn.canMove=true
        return
    end
    Dyn.moveMethod="none"
    Dyn.canMove=false
    dbg("move method:",Dyn.moveMethod)
end

-- ===================== БУСТ СКОРОСТИ (+3) =====================
local function startBoost()
    if not ctx.hum or ctx.boosting then return end
    local ok=pcall(function()
        local cur=ctx.hum.WalkSpeed
        if cur>0 and cur<200 then
            ctx.originalWalkSpeed=cur
            ctx.hum.WalkSpeed=cur+Config.BoostAmount
            ctx.boosting=true
            ctx.boostEnd=os.clock()+Config.BoostDuration
        end
    end)
end

local function endBoost()
    if not ctx.hum or not ctx.boosting then return end
    pcall(function()
        ctx.hum.WalkSpeed=ctx.originalWalkSpeed
        ctx.boosting=false
    end)
end

local function checkBoost()
    if ctx.boosting and os.clock()>=ctx.boostEnd then
        endBoost()
    end
end

-- ===================== МОНИТОРИНГ СОСТОЯНИЯ =====================
local function monitorState(now)
    if not ctx.hum or not ctx.char then
        cachedReason="NoCharacter"
        return
    end
    -- Health
    local ok,hp=pcall(function() return ctx.hum.Health end)
    if not ok or hp<=0 then
        cachedReason="Dead"
        return
    end
    -- State
    local ok2,state=pcall(function() return ctx.hum:GetState() end)
    if ok2 and BAD_STATES[state] then
        cachedReason="BadState"
        return
    end
    -- WalkSpeed (stun/freeze)
    local ok3,ws=pcall(function() return ctx.hum.WalkSpeed end)
    if ok3 and ws<Config.MinWalkSpeed then
        cachedReason="Rooted"
        return
    end
    -- Anchored
    if ctx.hrp and ctx.hrp.Anchored then
        cachedReason="Anchored"
        return
    end
    -- Seated
    local ok4,sit=pcall(function() return ctx.hum.Sit end)
    if ok4 and sit then
        cachedReason="Seated"
        return
    end
    -- PlatformStand
    local ok5,ps=pcall(function() return ctx.hum.PlatformStand end)
    if ok5 and ps then
        cachedReason="Platform"
        return
    end
    -- Ragdoll constraints
    local bs=ctx.char:FindFirstChildWhichIsA("BallSocketConstraint",true)
    if bs then
        local ok6,en=pcall(function() return bs.Enabled end)
        if ok6 and en then
            cachedReason="Ragdoll"
            return
        end
    end
    -- Пересчитываем скорость если изменилась
    if ok3 and math.abs(ws-Dyn.baseWalkSpeed)>1.0 and not ctx.boosting then
        Dyn.baseWalkSpeed=ws
        Dyn.dashSpeed=ws*Config.SpeedMultiplier
    end
    if cachedReason then cachedReason=nil end
end

